;; workspace.sb — macOS Seatbelt (sandbox-exec) profile confining a command to
;; a single workspace directory.
;;
;; PROTOTYPE. Launch with:
;;   sandbox-exec -D WORKSPACE=/abs/workspace -f workspace.sb CMD...
;; (run-sandboxed.sh resolves WORKSPACE to an absolute path first.)
;;
;; DESIGN: this uses (allow default) as the base, then carves out the sensitive
;; reads and jails writes to the workspace (network is left allowed — see
;; below). That is a deliberate trade-off. A hand-rolled (deny default) profile
;; is stricter on
;; paper but reliably ABORTS ordinary programs at launch (exit -6 / SIGABRT)
;; because the dynamic linker and system libraries need many paths that are hard
;; to enumerate and that change between macOS versions. (allow default) launches
;; everything reliably; the carve-outs below are what actually matter for
;; containment. See README.md for a stricter, tune-it-yourself variant.
;;
;; What this blocks:
;;   - reading home directories, the login keychain, and root's home
;;   - writing anywhere except the workspace and scratch temp dirs
;; What it still allows (weaker than a full jail): reading system locations such
;; as /etc, /usr, /Library (minus keychains), /opt, /Applications, AND the
;; network — because valet's job is running credentialed cloud commands (aws,
;; gcloud, psql over a network DB), which need it. sandbox-exec cannot filter
;; network by hostname, so it is all-or-nothing: uncomment the (deny network*)
;; line at the bottom for a stricter, offline-only profile (that also blocks a
;; command from exfiltrating over the network, at the cost of breaking cloud
;; tools).

(version 1)

;; Base: allow what a normal process needs to launch and run. Everything below
;; narrows this; in SBPL the LAST matching rule wins.
(allow default)

;; --- Reads: block the sensitive locations outside the workspace ------------
(deny file-read*
    (subpath "/Users")
    (subpath "/private/var/root")
    (subpath "/private/var/db/sudo")
    (subpath "/Library/Keychains")
    (subpath "/Network/Users"))

;; Re-grant the workspace, which lives under /Users. WORKSPACE is passed with -D
;; and must be an absolute, symlink-free path.
(allow file-read* (subpath (param "WORKSPACE")))

;; Allow *traversal into* the workspace even though an ancestor (e.g. /Users, or
;; the whole home when WORKSPACE is ~) is read-denied above. path-ancestors
;; grants metadata + existence on the ancestor chain only — enough for path
;; resolution and realpath(3) to walk in, but NOT enough to list a denied dir's
;; contents (so `ls /Users` still cannot enumerate other homes). Without this,
;; realpath on anything under the workspace fails with "Operation not permitted".
(allow file-read-metadata file-test-existence (path-ancestors (param "WORKSPACE")))

;; --- Writes: confine to the workspace and scratch temp ---------------------
(deny file-write* (subpath "/"))
(allow file-write*
    (subpath (param "WORKSPACE"))
    (subpath "/private/tmp")
    (subpath "/private/var/tmp")
    (subpath "/private/var/folders")
    (literal "/dev/null")
    (literal "/dev/zero")
    (literal "/dev/tty")
    (literal "/dev/stdout")
    (literal "/dev/stderr")
    (literal "/dev/dtracehelper"))

;; --- Network: allowed (see the header). Uncomment to block it entirely —
;; stops exfiltration over the network, but also breaks aws/gcloud/psql. ------
;; (deny network*)
